# Public site URL (used for Spotify OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# On Netlify: leave unset — @netlify/database auto-provisions Postgres
#   and sets NETLIFY_DATABASE_URL / NETLIFY_DB_URL for you.
# Locally (optional): any Postgres connection string
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Spotify Developer App credentials (optional — demo catalog works without these)
# https://developer.spotify.com/dashboard
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/spotify/export
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
