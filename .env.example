# Render sets this automatically from the Blueprint database.
# Locally, point at any Postgres instance.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public site URL (optional; useful for absolute links)
# On Render: https://okaylist.onrender.com (your service URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Spotify (not required for catalog + manual playlist flow)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
