# Public site URL (used for Spotify OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets backend (required for multi-device / Netlify deploys)
# 1. Create a Google Cloud service account with Sheets API enabled
# 2. Create a blank Google Spreadsheet and share it with the service account email (Editor)
# 3. Paste the spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON. Keep \n escape sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spotify Developer App credentials (optional — demo catalog works without these)
# https://developer.spotify.com/dashboard
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/spotify/export
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
