# Public site URL (used for Spotify OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Apps Script backend (required for multi-device / Netlify deploys)
# See apps-script/Code.gs for setup steps.
# Deploy the script as a Web app (Execute as: Me, Who has access: Anyone),
# then paste the URL and the same secret you set in Script properties.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
GOOGLE_APPS_SCRIPT_SECRET=pick-a-long-random-string

# Spotify Developer App credentials (optional — demo catalog works without these)
# https://developer.spotify.com/dashboard
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/spotify/export
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
