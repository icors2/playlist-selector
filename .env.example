# Public site URL (used for Spotify OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# On Netlify: leave unset — @netlify/database auto-provisions Postgres.
# Locally (optional):
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Spotify Developer App (required to import/update real playlists)
# https://developer.spotify.com/dashboard
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/spotify/export
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
