# Render sets this automatically from the Blueprint database.
# Locally, point at any Postgres instance.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public site URL — required for Spotify OAuth export redirects
# On Render: https://okaylist.onrender.com (your exact service URL, no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify Developer App (primary song search + playlist import/export)
# https://developer.spotify.com/dashboard
#
# Redirect URI to add in the Spotify app settings:
#   {NEXT_PUBLIC_APP_URL}/api/spotify/export
# Examples:
#   https://okaylist.onrender.com/api/spotify/export
#   http://localhost:3000/api/spotify/export
#
# Search uses Client Credentials (no redirect). Export uses OAuth (needs redirect).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
